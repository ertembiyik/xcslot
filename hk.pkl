amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"

local format = new Mapping<String, Step> {
  ["format"] {
    glob = List("**/*.ts", "**/*.json", "**/*.md", "**/*.yml")

    check = new CommandSpec {
      command = new Command {
        argv = List("bun", "fmt", "--check", "{{files}}")
      }
      effect = "read"
    }

    fix = new CommandSpec {
      command = new Command {
        argv = List("bun", "fmt", "{{files}}")
      }
      effect = "write"
    }
  }
}

local verify = new Mapping<String, Step> {
  ["verify"] {
    check = new CommandSpec {
      command = new Command {
        argv = List("bun", "run", "verify")
      }
      effect = "read"
    }
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = format
  }

  ["pre-push"] {
    steps = verify
  }

  ["check"] {
    steps = verify
  }
}
